{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#000000",
    "foreground": "#e7e9ea",
    "comment": "#8b949e",
    "panel": "#30363d",
    "red": "#ff7b72",
    "orange": "#ffa657",
    "yellow": "#e3b341",
    "green": "#7ee787",
    "nodegreen": "#3fb950",
    "blue": "#79c0ff",
    "azure": "#58a6ff",
    "sky": "#a5d6ff",
    "purple": "#d2a8ff",
    "violet": "#bc8cff",
    "cyan": "#56d4dd"
  },
  "secondary_prompt": {
    "template": "❯❯ ",
    "foreground": "p:comment",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "❯ ",
    "foreground": "p:foreground",
    "background": "transparent",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "newline": true
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Folder }}{{ if .Root }} :: root{{ end }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:comment",
          "template": "╭─"
        },
        {
          "options": {
            "macos": ""
          },
          "template": " {{ .Icon }} ",
          "foreground": "#000000",
          "background": "#ff7b72",
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "#ff7b72",
          "background": "#512724",
          "template": "{{ if .SSHSession }}  {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "options": {
            "folder_icon": "",
            "folder_separator_icon": "  ",
            "home_icon": "",
            "max_depth": 2,
            "style": "agnoster_short",
            "mapped_locations": {
              "~/Workspace": "󰃖",
              "~/Desktop": "󰇄",
              "~/Documents": "󰈙",
              "~/Downloads": "󰉍",
              "~/Pictures": "󰉏",
              "~/Movies": "󰕧",
              "~/Music": "󰝚",
              "~/Screenshots": "󰄀",
              "~/Applications": "󰀻",
              "~/Library": "󰂺",
              "~/Public": "",
              "~/dev": "",
              "~/go": ""
            }
          },
          "template": " {{ if eq .Path \"\" }} Home{{ else if eq .Path \"󰃖\" }}󰃖 Workspace{{ else if eq .Path \"󰇄\" }}󰇄 Desktop{{ else if eq .Path \"󰈙\" }}󰈙 Documents{{ else if eq .Path \"󰉍\" }}󰉍 Downloads{{ else if eq .Path \"󰉏\" }}󰉏 Pictures{{ else if eq .Path \"󰕧\" }}󰕧 Movies{{ else if eq .Path \"󰝚\" }}󰝚 Music{{ else if eq .Path \"󰄀\" }}󰄀 Screenshots{{ else if eq .Path \"󰀻\" }}󰀻 Applications{{ else if eq .Path \"󰂺\" }}󰂺 Library{{ else if eq .Path \"\" }} Public{{ else if eq .Path \"\" }} dev{{ else if eq .Path \"\" }} go{{ else }}{{ .Path }}{{ end }} ",
          "foreground": "#d2a8ff",
          "powerline_symbol": "",
          "background": "#433551",
          "type": "path",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "type": "project",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "#a5d6ff",
          "background": "#344451",
          "template": "{{ if .Version }}  {{ .Version }} {{ end }}"
        },
        {
          "options": {
            "branch_max_length": 25,
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " 󰘬 {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "#7ee787",
          "powerline_symbol": "",
          "background": "#28492b",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#512724{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#51351b{{ end }}",
            "{{ if gt .Behind 0 }}#263d51{{ end }}"
          ],
          "leading_powerline_symbol": "",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff7b72{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffa657{{ end }}",
            "{{ if gt .Behind 0 }}#79c0ff{{ end }}"
          ]
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": true,
            "fetch_package_manager": true
          },
          "template": " 󰎙 {{ .Full }}{{ if .PackageManagerIcon }} {{ .PackageManagerIcon }}{{ end }} ",
          "foreground": "#ff9bce",
          "powerline_symbol": "",
          "background": "#513141",
          "type": "node",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": true,
            "fetch_virtual_env": true
          },
          "template": " 󰌠 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}{{ if .Venv }} ({{ .Venv }}){{ end }} ",
          "foreground": "#e3b341",
          "powerline_symbol": "",
          "background": "#483914",
          "type": "python",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " 󰟓 {{ .Full }} ",
          "foreground": "#56d4dd",
          "powerline_symbol": "",
          "background": "#1b4346",
          "type": "go",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " 󱘗 {{ .Full }} ",
          "foreground": "#ffa657",
          "powerline_symbol": "",
          "background": "#51351b",
          "type": "rust",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "template": "  {{ .Context }} ",
          "foreground": "#79c0ff",
          "powerline_symbol": "",
          "background": "#263d51",
          "type": "docker",
          "style": "powerline",
          "options": {
            "display_mode": "files",
            "fetch_context": true,
            "extensions": [
              "compose.yml",
              "compose.yaml",
              "docker-compose.yml",
              "docker-compose.yaml",
              "compose.*.yml",
              "compose.*.yaml",
              "docker-compose.*.yml",
              "docker-compose.*.yaml",
              "Dockerfile",
              "Dockerfile.*"
            ]
          },
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "parse_kubeconfig": true
          },
          "template": " 󱃾 {{ .Context }}{{ if .Namespace }}  {{ .Namespace }}{{ end }} ",
          "foreground": "#bc8cff",
          "powerline_symbol": "",
          "background": "#3c2c51",
          "type": "kubectl",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "display_mode": "context"
          },
          "template": "{{ if .Profile }} 󰸏 {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} {{ end }}",
          "foreground": "#ffa657",
          "powerline_symbol": "",
          "background": "#51351b",
          "type": "aws",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "options": {
            "display_mode": "context"
          },
          "template": "{{ if .Project }} 󰫳 {{ .Project }} {{ end }}",
          "foreground": "#79c0ff",
          "powerline_symbol": "",
          "background": "#263d51",
          "type": "gcp",
          "style": "powerline",
          "leading_powerline_symbol": ""
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "#e3b341",
          "background": "#483914",
          "template": "{{ if .Env.DIRENV_DIR }}  {{ end }}"
        },
        {
          "template": "  ",
          "foreground": "#ff7b72",
          "powerline_symbol": "",
          "background": "#512724",
          "type": "root",
          "style": "powerline",
          "leading_powerline_symbol": ""
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:yellow",
          "options": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if gt .Code 0 }}  {{ .Code }} {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "{{ if and .Env.OMP_JOBS (ne .Env.OMP_JOBS \"0\") }}  {{ .Env.OMP_JOBS }} {{ end }}"
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if lt .Percentage 30 }} 󰂃 {{ .Percentage }}% {{ end }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:comment",
          "options": {
            "time_format": "15:04"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "template": "<p:comment>╰─</>❯ ",
          "foreground": "p:foreground",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ]
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}